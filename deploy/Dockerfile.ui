# ── Stage 1: build WASM + static assets ──────────────────────────────────────
# Pinned to rust-toolchain.toml's channel: images used to build with whatever
# `rust:latest` was, not the toolchain CI tests. Bump BOTH together.
ARG RUST_VERSION=1.97
FROM rust:${RUST_VERSION} AS builder

RUN apt-get update && apt-get install -y \
    pkg-config libssl-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Install a PINNED, checksum-verified trunk release binary.
# SECURITY / reproducibility (2026-10-16): this replaced `curl … binstall
# script from main | bash && cargo binstall trunk`, which ran an unpinned
# script and installed whatever trunk was latest. When binstall's download
# timed out it fell back to `cargo install trunk` WITHOUT --locked, resolved
# newer deps (lightningcss vs cssparser) and broke the build (develop CI,
# 2026-10-16). Now: exact version, published SHA-256s (cross-checked against
# the downloaded tarballs), transient network errors retried, never a source
# build. To bump: update TRUNK_VERSION and both checksums from the release's
# `<asset>.sha256` files, and verify them against the tarballs.
ARG TRUNK_VERSION=0.21.14
ARG TRUNK_SHA256_X86_64=f2b4680cd239693a646a2795e4633c625328d7b2a044fbe749fa3a2fe9e7036b
ARG TRUNK_SHA256_AARCH64=b1d8e60e454f7fc182d9a4d95d1506ffbae947d8ba90f8f6f02da93b60f980f9
RUN set -eu; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64)  sha="$TRUNK_SHA256_X86_64" ;; \
      aarch64) sha="$TRUNK_SHA256_AARCH64" ;; \
      *) echo "unsupported build arch: $arch" >&2; exit 1 ;; \
    esac; \
    asset="trunk-${arch}-unknown-linux-gnu.tar.gz"; \
    curl -fsSL --proto '=https' --tlsv1.2 --retry 5 --retry-all-errors --retry-delay 3 \
      -o "/tmp/$asset" \
      "https://github.com/trunk-rs/trunk/releases/download/v${TRUNK_VERSION}/${asset}"; \
    echo "$sha  /tmp/$asset" | sha256sum -c -; \
    tar -xzf "/tmp/$asset" -C /usr/local/bin trunk; \
    rm "/tmp/$asset"; \
    trunk --version

RUN rustup target add wasm32-unknown-unknown

WORKDIR /build

# Pre-fetch workspace dependencies before copying real source so Docker
# layer cache is reused when only application code changes.
COPY Cargo.toml Cargo.lock ./
COPY common/Cargo.toml ./common/Cargo.toml
COPY api/Cargo.toml    ./api/Cargo.toml
COPY ui/Cargo.toml     ./ui/Cargo.toml

RUN mkdir -p common/src api/src ui/src \
    && echo "" > common/src/lib.rs \
    && echo "fn main(){}" > api/src/main.rs \
    && echo "fn main(){}" > ui/src/main.rs \
    && cargo fetch

# Copy real source and build
COPY common/ ./common/
COPY ui/     ./ui/

WORKDIR /build/ui
RUN trunk build --release

# ── Stage 2: nginx static serving (non-root) ──────────────────────────────────
# nginx-unprivileged runs as the unprivileged `nginx` user (uid 101) and binds
# port 8080 instead of 80 — no root, no Linux capabilities required. The edge
# proxy / ingress forwards to this container on 8080.
FROM nginxinc/nginx-unprivileged:alpine

# trunk outputs to dist/ relative to the ui crate directory
COPY --from=builder /build/ui/dist /usr/share/nginx/html

# SPA fallback + compression + long-lived asset caching
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
